@{
    ViewData["Title"] = "Movimientos Tarjeta (LOAN)";
}

<style>
    /* Estilos personalizados para la pantalla de Movimientos Tarjeta LOAN */
    .loan-container {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #1e293b;
    }
    
    .loan-header-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-radius: 16px;
        padding: 24px 30px;
        color: #ffffff;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.2);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    
    .loan-header-title {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin: 0 0 6px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .loan-header-subtitle {
        font-size: 13.5px;
        color: #94a3b8;
        margin: 0;
    }

    .loan-search-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        margin-bottom: 28px;
    }

    .search-input-group {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-input-wrapper {
        position: relative;
        flex: 1;
    }

    .search-input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 16px;
        transition: color 0.2s ease;
    }

    .loan-search-input {
        width: 100%;
        height: 50px;
        padding: 12px 16px 12px 48px;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        font-size: 15px;
        font-weight: 500;
        color: #0f172a;
        background-color: #f8fafc;
        transition: all 0.2s ease-in-out;
        outline: none;
    }

    .loan-search-input:focus {
        border-color: #0284c7;
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.12);
    }

    .btn-loan-search {
        height: 50px;
        padding: 0 28px;
        border-radius: 12px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        border: none;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .btn-loan-search:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
        color: #ffffff;
    }

    .btn-loan-clear {
        height: 50px;
        padding: 0 20px;
        border-radius: 12px;
        background-color: #f1f5f9;
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-loan-clear:hover {
        background-color: #e2e8f0;
        color: #334155;
    }

    /* Skeleton loader styling */
    .loan-loader {
        padding: 60px 20px;
        text-align: center;
    }
    
    .spinner-ring {
        display: inline-block;
        width: 50px;
        height: 50px;
        border: 4px solid rgba(2, 132, 199, 0.15);
        border-radius: 50%;
        border-top-color: #0284c7;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div class="loan-container">
    <!-- Header Principal -->
    <div class="loan-header-card">
        <div>
            <h1 class="loan-header-title">
                <i class="fa fa-credit-card" style="color: #38bdf8;"></i> Movimientos Tarjeta (LOAN)
            </h1>
            <p class="loan-header-subtitle">
                Consulta instantánea de saldos, cuotas y movimientos de tarjetas de crédito LOAN.
            </p>
        </div>
        <div class="hidden-xs">
            <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 8px 16px; border-radius: 30px; font-size: 13px; font-weight: 600;">
                <i class="fa fa-refresh"></i> En línea con LOAN API
            </span>
        </div>
    </div>

    <!-- Tarjeta de Búsqueda -->
    <div class="loan-search-card">
        <form id="formBuscarMovimientos" action="/Core/MovimientoTarjeta/Buscar" method="post">
            <div class="search-input-group">
                <div class="search-input-wrapper">
                    <i class="fa fa-search search-input-icon"></i>
                    <input type="text" 
                           id="busqueda" 
                           name="busqueda" 
                           class="loan-search-input" 
                           placeholder="Ingrese el DNI o Número de Tarjeta (con o sin ceros adelante)..." 
                           required 
                           autocomplete="off" />
                </div>
                <button type="submit" id="btnBuscar" class="btn-loan-search">
                    <i class="fa fa-search"></i> Consultar
                </button>
                <button type="button" id="btnLimpiar" class="btn-loan-clear">
                    <i class="fa fa-eraser"></i> Limpiar
                </button>
            </div>
        </form>
    </div>

    <!-- Spinner de Carga -->
    <div id="loadingSpinner" class="loan-loader" style="display: none;">
        <div class="spinner-ring"></div>
        <h4 style="margin-top: 16px; font-weight: 600; color: #334155;">Consultando datos en LOAN...</h4>
        <p style="color: #94a3b8; font-size: 13px;">Obteniendo información del titular, saldos y movimientos</p>
    </div>

    <!-- Contenedor del Resultado -->
    <div id="contenedorResultado">
        <!-- El resultado se cargará aquí dinámicamente -->
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#formBuscarMovimientos').on('submit', function (e) {
                e.preventDefault();
                var busquedaVal = $('#busqueda').val().trim();
                if (!busquedaVal) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Campo Requerido',
                            text: 'Ingrese un DNI o Número de Tarjeta para consultar.',
                            confirmButtonColor: '#0284c7'
                        });
                    } else {
                        alert('Ingrese un DNI o Número de Tarjeta para consultar.');
                    }
                    return;
                }

                $('#loadingSpinner').show();
                $('#contenedorResultado').hide().empty();

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: { busqueda: busquedaVal },
                    success: function (data) {
                        $('#loadingSpinner').hide();
                        $('#contenedorResultado').html(data).fadeIn(300);
                    },
                    error: function (xhr, status, error) {
                        $('#loadingSpinner').hide();
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de servidor',
                                text: 'No se pudo completar la consulta. Verifique la conexión o vuelva a intentarlo.',
                                confirmButtonColor: '#ef4444'
                            });
                        } else {
                            alert('No se pudo completar la consulta. Intente nuevamente.');
                        }
                    }
                });
            });

            $('#btnLimpiar').on('click', function () {
                $('#busqueda').val('').focus();
                $('#contenedorResultado').fadeOut(200, function() { $(this).empty(); });
            });
        });
    </script>
}
