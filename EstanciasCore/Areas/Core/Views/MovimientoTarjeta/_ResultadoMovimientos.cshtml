@model DAL.Mobile.ListaMovimientoTarjetaDTO

<style>
    .result-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        margin-bottom: 24px;
        overflow: hidden;
    }

    /* Customer Header */
    .profile-header {
        padding: 24px;
        background: #ffffff;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .profile-avatar {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
        flex-shrink: 0;
    }

    .profile-info {
        flex: 1;
        min-width: 250px;
    }

    .profile-name {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 8px 0;
        letter-spacing: -0.3px;
    }

    .profile-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .info-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
    }

    .info-tag-primary {
        background-color: #eff6ff;
        border-color: #bfdbfe;
        color: #1d4ed8;
    }

    .info-tag-success {
        background-color: #ecfdf5;
        border-color: #a7f3d0;
        color: #047857;
    }

    /* KPI Metrics Grid */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .metric-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
    }

    .metric-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
    }

    .metric-card-danger::before { background: linear-gradient(90deg, #ef4444, #dc2626); }
    .metric-card-success::before { background: linear-gradient(90deg, #10b981, #059669); }
    .metric-card-warning::before { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .metric-card-info::before { background: linear-gradient(90deg, #0284c7, #0284c7); }

    .metric-label {
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .metric-value {
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 4px;
    }

    .metric-card-danger .metric-value { color: #dc2626; }
    .metric-card-success .metric-value { color: #059669; }
    .metric-card-warning .metric-value { color: #d97706; }
    .metric-card-info .metric-value { color: #0284c7; }

    .metric-footer {
        font-size: 12px;
        color: #94a3b8;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Warning Banner */
    .punitorios-banner {
        background: linear-gradient(135deg, #fffbe6 0%, #fef3c7 100%);
        border: 1px solid #fde68a;
        border-left: 6px solid #f59e0b;
        border-radius: 14px;
        padding: 18px 24px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .punitorios-title {
        font-size: 15px;
        font-weight: 700;
        color: #b45309;
        margin: 0 0 4px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .punitorios-desc {
        font-size: 13px;
        color: #78350f;
        margin: 0;
    }

    .punitorios-total {
        font-size: 18px;
        font-weight: 800;
        color: #92400e;
        background: #ffffff;
        padding: 8px 16px;
        border-radius: 10px;
        border: 1px solid #fde68a;
        box-shadow: 0 2px 6px rgba(180, 83, 9, 0.08);
    }

    /* Modern Table */
    .section-header {
        padding: 20px 24px;
        background: #ffffff;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .section-title {
        font-size: 17px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-modern {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .table-modern th {
        background-color: #f8fafc;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 14px 24px;
        border-bottom: 1px solid #e2e8f0;
        text-align: left;
    }

    .table-modern td {
        padding: 16px 24px;
        border-bottom: 1px solid #f1f5f9;
        color: #334155;
        font-size: 14px;
        vertical-align: middle;
    }

    .table-modern tr:last-child td {
        border-bottom: none;
    }

    .table-modern tr:hover td {
        background-color: #f8fafc;
    }

    .date-pill {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        background-color: #f1f5f9;
        color: #475569;
        font-size: 12.5px;
        font-weight: 600;
    }

    .amount-text {
        font-weight: 700;
        color: #0f172a;
    }

    .surcharge-text {
        font-weight: 600;
        color: #ef4444;
    }
</style>

@if (ViewBag.Error != null || Model == null)
{
    <div style="background-color: #fef2f2; border: 1px solid #fecaca; border-left: 5px solid #ef4444; border-radius: 12px; padding: 20px; margin-top: 15px; color: #991b1b;">
        <h4 style="margin: 0 0 6px 0; font-weight: 700; font-size: 16px; display: flex; align-items: center; gap: 8px;">
            <i class="fa fa-exclamation-circle" style="color: #ef4444;"></i> Consulta no realizada
        </h4>
        <p style="margin: 0; font-size: 14px; color: #b91c1c;">
            @(ViewBag.Error ?? "No se encontraron datos para la búsqueda ingresada.")
        </p>
    </div>
}
else
{
    <div>
        <!-- Customer Profile Card -->
        <div class="result-card">
            <div class="profile-header">
                <div class="profile-avatar">
                    @(string.IsNullOrEmpty(Model.Nombre) ? "C" : Model.Nombre.Substring(0, 1).ToUpper())
                </div>
                <div class="profile-info">
                    <h3 class="profile-name">@Model.Nombre</h3>
                    <div class="profile-tags">
                        <span class="info-tag info-tag-primary">
                            <i class="fa fa-id-card"></i> DNI: <strong>@Model.NroDocumento</strong>
                        </span>
                        <span class="info-tag info-tag-success">
                            <i class="fa fa-credit-card"></i> Tarjeta: <strong>@Model.NroTarjeta</strong>
                        </span>
                        @if (!string.IsNullOrEmpty(Model.Direccion))
                        {
                            <span class="info-tag">
                                <i class="fa fa-map-marker"></i> @Model.Direccion
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric KPI Cards -->
        <div class="metrics-grid">
            <div class="metric-card metric-card-danger">
                <div class="metric-label">Monto Adeudado Total</div>
                <div class="metric-value">$ @Model.MontoAdeudado</div>
                <div class="metric-footer">
                    <i class="fa fa-shield"></i> Estado de Deuda LOAN
                </div>
            </div>

            <div class="metric-card metric-card-info">
                <div class="metric-label">Próxima Cuota</div>
                <div class="metric-value">$ @Model.TotalProximaCuota</div>
                <div class="metric-footer">
                    <i class="fa fa-clock-o"></i> Vencimiento: <strong>@Model.FechaPagoProximaCuota</strong>
                </div>
            </div>

            <div class="metric-card metric-card-success">
                <div class="metric-label">Monto Disponible</div>
                <div class="metric-value">$ @Model.MontoDisponible</div>
                <div class="metric-footer">
                    <i class="fa fa-check-circle"></i> Crédito disponible
                </div>
            </div>
        </div>

        <!-- Transactions Table -->
        <div class="result-card">
            <div class="section-header">
                <h3 class="section-title">
                    <i class="fa fa-list-alt" style="color: #0284c7;"></i> Últimos Movimientos
                </h3>
                <span class="badge" style="background: #e2e8f0; color: #334155; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: 600;">
                    @Model.CantMovimientos registro(s)
                </span>
            </div>

            @if (Model.MovimientosTarjeta != null && Model.MovimientosTarjeta.Any())
            {
                <div style="overflow-x: auto;">
                    <table class="table-modern">
                        <thead>
                            <tr>
                                <th style="width: 18%;">Fecha</th>
                                <th style="width: 48%;">Concepto / Detalle</th>
                                <th style="width: 17%; text-align: right;">Monto</th>
                                <th style="width: 17%; text-align: right;">Recargo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mov in Model.MovimientosTarjeta)
                            {
                                <tr>
                                    <td><span class="date-pill">@mov.Fecha</span></td>
                                    <td><strong style="color: #0f172a;">@mov.TipoMovimiento</strong></td>
                                    <td style="text-align: right;" class="amount-text">$ @mov.Monto</td>
                                    <td style="text-align: right;" class="surcharge-text">
                                        @(string.IsNullOrEmpty(mov.Recargo) ? "$ 0,00" : "$ " + mov.Recargo)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div style="padding: 40px 20px; text-align: center; color: #94a3b8;">
                    <i class="fa fa-info-circle fa-2x" style="margin-bottom: 8px;"></i>
                    <p style="margin: 0; font-size: 14px; font-weight: 500;">No se registraron movimientos recientes para esta tarjeta.</p>
                </div>
            }
        </div>

        <!-- Solicitudes y Cuotas Accordion (ObtenerConsulta & SOAP) -->
        @{
            var consultaData = ViewBag.MontosConPunitorios as DAL.DTOs.ApiCpeCreditos.ResponseObtenerConsultaDTO;
            var rawData = ViewBag.DatosMovimientosRaw as EstanciasCore.Services.CombinedData;
            var cultureAR = new System.Globalization.CultureInfo("es-AR");
        }

        @if (consultaData != null && consultaData.cobranzas != null && consultaData.cobranzas.Any())
        {
            var cobranzasPorSolicitud = consultaData.cobranzas.GroupBy(c => c.numero).ToList();

            <div class="result-card" style="margin-top: 20px;">
                <div class="section-header" style="cursor: pointer;" data-toggle="collapse" data-target="#detalleCuotasCollapse">
                    <h3 class="section-title">
                        <i class="fa fa-file-text-o" style="color: #64748b;"></i> Detalle de Solicitudes y Cuotas de LOAN (@consultaData.cobranzas.Count)
                    </h3>
                    <i class="fa fa-chevron-down" style="color: #94a3b8;"></i>
                </div>
                <div id="detalleCuotasCollapse" class="collapse in" style="padding: 16px 24px;">
                    @foreach (var grupo in cobranzasPorSolicitud)
                    {
                        <div style="margin-bottom: 20px; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
                            <div style="padding: 12px 18px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; font-size: 14px; font-weight: 700; color: #1e293b; display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    Solicitud / Operación N°: <span style="color: #0284c7;">@grupo.Key</span>
                                    @(string.IsNullOrEmpty(grupo.FirstOrDefault()?.detalle) ? "" : " | " + grupo.FirstOrDefault()?.detalle)
                                </div>
                                <span class="badge" style="background: #e0f2fe; color: #0369a1; font-size: 12px; padding: 4px 10px;">
                                    @grupo.Count() cuota(s)
                                </span>
                            </div>
                            <div style="overflow-x: auto;">
                                <table class="table-modern">
                                    <thead>
                                        <tr>
                                            <th>Cuota N°</th>
                                            <th>Vencimiento</th>
                                            <th>Detalle</th>
                                            <th style="text-align: right;">Importe Total ($)</th>
                                            <th style="text-align: right;">Capital ($)</th>
                                            <th style="text-align: right;">Punitorio por Cuota ($)</th>
                                            <th style="text-align: center;">Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cuota in grupo)
                                        {
                                            var punitorioCuota = cuota.importe - cuota.importeCapital;
                                            if (punitorioCuota < 0) { punitorioCuota = 0; }

                                            <tr>
                                                <td><strong>Cuota @cuota.numeroCuota</strong></td>
                                                <td><span class="date-pill">@cuota.fechaVencimiento.ToString("dd/MM/yyyy")</span></td>
                                                <td>@(string.IsNullOrEmpty(cuota.detalle) ? "-" : cuota.detalle)</td>
                                                <td style="text-align: right;" class="amount-text">
                                                    $ @cuota.importe.ToString("N2", cultureAR)
                                                </td>
                                                <td style="text-align: right;">
                                                    $ @cuota.importeCapital.ToString("N2", cultureAR)
                                                </td>
                                                <td style="text-align: right; font-weight: 700;" class="@(punitorioCuota > 0 ? "surcharge-text" : "")">
                                                    $ @punitorioCuota.ToString("N2", cultureAR)
                                                </td>
                                                <td style="text-align: center;">
                                                    @if (cuota.diasEnMora > 0)
                                                    {
                                                        <span class="badge" style="background: #fef2f2; color: #dc2626; border: 1px solid #fecaca;">
                                                            @cuota.diasEnMora días mora
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge" style="background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0;">
                                                            Al día
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (rawData != null && rawData.DetallesSolicitud != null && rawData.DetallesSolicitud.Any())
        {
            <div class="result-card" style="margin-top: 20px;">
                <div class="section-header" style="cursor: pointer;" data-toggle="collapse" data-target="#detalleCuotasCollapse">
                    <h3 class="section-title">
                        <i class="fa fa-file-text-o" style="color: #64748b;"></i> Detalle de Solicitudes y Cuotas de LOAN
                    </h3>
                    <i class="fa fa-chevron-down" style="color: #94a3b8;"></i>
                </div>
                <div id="detalleCuotasCollapse" class="collapse in" style="padding: 16px 24px;">
                    @foreach (var sol in rawData.DetallesSolicitud)
                    {
                        <div style="margin-bottom: 20px; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
                            <div style="padding: 12px 18px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; font-size: 14px; font-weight: 700; color: #1e293b;">
                                Solicitud N°: <span style="color: #0284c7;">@sol.NumeroSolicitud</span> | Comercio: @sol.NombreComercio
                            </div>
                            @if (sol.DetallesCuota != null && sol.DetallesCuota.Any())
                            {
                                <table class="table-modern">
                                    <thead>
                                        <tr>
                                            <th>Cuota N°</th>
                                            <th>Vencimiento</th>
                                            <th style="text-align: right;">Monto Total ($)</th>
                                            <th style="text-align: right;">Punitorio por Cuota ($)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cuota in sol.DetallesCuota)
                                        {
                                            decimal.TryParse(cuota.Monto?.Replace(".", ","), out decimal mVal);
                                            // Buscar si existe cobranza correspondiente en consultaData
                                            var cobMatch = consultaData?.cobranzas?.FirstOrDefault(c => c.numero.ToString() == sol.NumeroSolicitud && c.numeroCuota.ToString() == cuota.NumeroCuota);
                                            decimal punitCalc = cobMatch != null ? (cobMatch.importe - cobMatch.importeCapital) : 0;
                                            if (punitCalc < 0) { punitCalc = 0; }

                                            <tr>
                                                <td><strong>Cuota @cuota.NumeroCuota</strong></td>
                                                <td><span class="date-pill">@cuota.Fecha</span></td>
                                                <td style="text-align: right;" class="amount-text">$ @mVal.ToString("N2", cultureAR)</td>
                                                <td style="text-align: right; font-weight: 700;" class="@(punitCalc > 0 ? "surcharge-text" : "")">
                                                    $ @punitCalc.ToString("N2", cultureAR)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
