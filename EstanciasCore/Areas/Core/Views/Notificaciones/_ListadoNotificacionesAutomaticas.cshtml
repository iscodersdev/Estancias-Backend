@using DAL.Models.Core
@model Commons.Models.Page<Notificaciones>

<style>
    /* Centrar contenido horizontal y verticalmente */
    .table td, .table th {
        vertical-align: middle !important; /* Alineación vertical */
        text-align: center; /* Alineación horizontal */
    }

    /* Si tienes imágenes como en tu captura, esto asegura que no rompan el layout */
    .table img {
        display: block;
        margin: 0 auto;
    }

    /* Cambia el color de fondo de la fila al pasar el mouse */
    .table tbody tr:hover {
        background-color: #f5f5f5 !important; /* Un gris muy claro */
        transition: background-color 0.2s ease; /* Hace que el cambio sea suave */
        cursor: pointer; /* Cambia el cursor a una mano */
    }
</style>

<box-header title="@ViewBag.Titulo">
    <box-search update-div="tablaBanners">
    </box-search>
</box-header>

<box-body table="true">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Nombre
                </th>
                <th>
                    Descripcion
                </th>
                <th>
                    Plantilla
                </th>
                <th>
                    Estado
                </th>
                <th>
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descripcion)
                    </td>
                    <td>
                        @if (item.NotificacionesPlantillas!=null)
                        {
                            @Html.Raw($"<small class='label pull-center bg-primary'>{item.NotificacionesPlantillas.Nombre}</small>")
                        }
                        else
                        {
                            @Html.Raw("<small class='label pull-center bg-yellow'>Sin Plantilla</small>")
                        }
                    </td>
                    <td>
                        @if (item.Activo)
                        {
                            @Html.Raw("<small class='label pull-center bg-green'>Activo</small>")
                        }
                        else
                        {
                            @Html.Raw("<small class='label pull-center bg-red'>Desactivado</small>")
                        }
                    </td>              
             
                 <td>
                    <a onclick="asignarPlantillaAutomaticas(@item.Id)" title="Asignar Plantilla" class="btn btn-warning btn-xs"><i class="fa fa-sticky-note"></i></a>
                    @if (item.Activo)
                    {
                        <a onclick="borrarNotificacion(@item.Id)" title="Deshabilitar" class="btn btn-danger btn-xs"><i class="fa fa-close"></i></a>
                    }
                    else
                    {
                        <a onclick="borrarNotificacion(@item.Id)" title="Habilitar" class="btn btn-success btn-xs"><i class="fa fa-check"></i></a>
                    }
                </td>
             </tr>
            }
        </tbody>
    </table>
</box-body>

