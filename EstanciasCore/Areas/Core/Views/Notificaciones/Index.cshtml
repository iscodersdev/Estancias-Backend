@{
    ViewData["Title"] = "Notificaciones";
}



<div class="row">
    <div class="col-md-12">
        <!-- Custom Tabs -->
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="active"><a href="#tab_manuales" data-toggle="tab" aria-expanded="true">Manuales</a></li>
                <li class=""><a href="#tab_automaticas" data-toggle="tab" aria-expanded="false">Automáticas</a></li>
                @* <li class="pull-right"><a href="#" class="text-muted"><i class="fa fa-gear"></i></a></li> *@
            </ul>
            <div class="tab-content">
                <div class="tab-pane active" id="tab_manuales">
                    <box color="Primary">
                        <load id="loadNotificaciones" load-url="/Core/Notificaciones/ObtenerNotificaciones">
                            <box-header title="Listado de Notificaciones Manuales"></box-header>
                        </load>
                    </box>
                </div>
                <div class="tab-pane" id="tab_automaticas">
                    <box color="Success">
                        <load id="loadNotificaciones" load-url="/Core/Notificaciones/ObtenerNotificacionesAutomaticas">
                            <box-header title="Listado de Notificaciones Autom+aticas"></box-header>
                        </load>
                    </box>
                </div>
            </div>
        </div>
    </div>
</div>




<modal title="Asignar Plantilla" function="asignarPlantilla" load-url="/Core/Notificaciones/_AsignarPlantilla/" size="Medium"></modal>
<modal title="Asignar Plantilla Automáticas" function="asignarPlantillaAutomaticas" load-url="/Core/Notificaciones/_AsignarPlantillaAutomaticas/" size="Medium"></modal>
<modal title="Asignar Lista de Distribución" function="asignarListaDistribucion" load-url="/Core/Notificaciones/_AsignarListaDistribucion/" size="Medium"></modal>

<script>
    function borrarNotificacionPermanente(id) {
        Swal.fire({
            title: '¿Estás seguro?',
            text: "Se eliminará permanentemente esta notificación.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sí, continuar!'
        }).then((result) => {
            if (result.value) {
                $.post("/Core/Notificaciones/BorrarPermanente", { id: id }, function (data) {
                     if (data.success) {
                        // Reload the table
                        if (typeof reload_loadNotificaciones === "function") {
                            reload_loadNotificaciones();
                        } else {
                            location.reload(); 
                        }
                    } else {
                        Swal.fire(
                            'Error!',
                            data.message,
                            'error'
                        )
                    }
                });
            }
        })
    }

    function borrarNotificacion(id) {
        Swal.fire({
            title: '¿Estás seguro?',
            text: "Se cambiará el estado de la notificación.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sí, continuar!'
        }).then((result) => {
            if (result.value) {
                $.post("/Core/Notificaciones/ToggleEstado", { id: id }, function (data) {
                     if (data.success) {
                        // Reload the table
                        if (typeof reload_loadNotificaciones === "function") {
                            reload_loadNotificaciones();
                        } else {
                            location.reload(); 
                        }
                    } else {
                        Swal.fire(
                            'Error!',
                            data.message,
                            'error'
                        )
                    }
                });
            }
        })
    }
</script>