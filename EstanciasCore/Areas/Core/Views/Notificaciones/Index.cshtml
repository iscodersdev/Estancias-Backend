@{
    ViewData["Title"] = "Notificaciones (Automáticas)";
}

<box color="Info">
    <load id="loadNotificaciones" load-url="/Core/Notificaciones/ObtenerNotificaciones">
        <box-header title="Listado de Notificaciones"></box-header>
    </load>
</box>

<modal title="Asignar Plantilla" function="asignarPlantilla" load-url="/Core/Notificaciones/_AsignarPlantilla/" size="Medium"></modal>

<script>
    function borrarBanner(id) {
        Swal.fire({
            title: '¿Estás seguro?',
            text: "Se cambiará el estado de la notificación.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Sí, continuar!'
        }).then((result) => {
            if (result.value) {
                $.post("/Core/Notificaciones/ToggleEstado", { id: id }, function (data) {
                     if (data.success) {
                        // Reload the table
                        if (typeof reload_loadNotificaciones === "function") {
                            reload_loadNotificaciones();
                        } else {
                            location.reload(); 
                        }
                    } else {
                        Swal.fire(
                            'Error!',
                            data.message,
                            'error'
                        )
                    }
                });
            }
        })
    }
</script>