
@model DAL.Models.Core.Notificaciones

<form asp-action="CambiarFecha" method="post" id="form-cambiar-fecha">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-md-6 form-group">
            <label>Día (1-31)</label>
            <input type="number" name="Dia" class="form-control" min="1" max="31" value="@(Model.FechaEjecucion.Day)" required />
        </div>
        <div class="col-md-6 form-group">
            <label>Hora</label>
            <input type="time" name="Hora" class="form-control" value="@(Model.FechaEjecucion.ToString("HH:mm"))" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 text-right">
             <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </div>
</form>

<script>
    $('#form-cambiar-fecha').submit(function (e) {
        e.preventDefault();
        var form = $(this);
        $.ajax({
            type: "POST",
            url: form.attr('action'),
            data: form.serialize(),
            success: function (data) {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Éxito',
                        text: data.message,
                    }).then((result) => {
                         // Close modal and reload (assuming generic modal closing behavior or reload)
                         $('.modal').modal('hide');
                         if (typeof reload_loadNotificaciones === "function") {
                            reload_loadNotificaciones();
                         } else {
                            location.reload(); 
                         }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message,
                    });
                }
            }
        });
    });
</script>
