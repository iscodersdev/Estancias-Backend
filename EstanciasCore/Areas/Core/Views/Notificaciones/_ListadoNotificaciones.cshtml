@using DAL.Models.Core
@model Commons.Models.Page<Notificaciones>

<box-header title="Listado">
    <box-search update-div="tablaBanners">
        <div class="input-group input-group-sm pull-right" style="max-width: 300px;">
            <a onclick="nuevaNotificacion()" class="btn btn-info btn-sm">
                <i class="fa fa-plus"><span class="hidden-xs"> Nueva</span></i>
            </a>
        </div>
    </box-search>
</box-header>

<box-body table="true">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Nombre
                </th>
                <th>
                    Descripcion
                </th>
                <th>
                    Codigo
                </th>
                <th>
                    Plantilla
                </th>
                <th>
                    Tipo
                </th>
                <th>
                    Estado
                </th>
                <th>
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descripcion)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Codigo)
                    </td>
                    <td>
                        @(item.NotificacionesPlantillas!=null? item.NotificacionesPlantillas.Nombre : "Sin Datos")
                    </td>
                    <td>
                        @(item.TipoNotificacionesProcedimientos!=null ? item.TipoNotificacionesProcedimientos.Nombre : "Sin Datos")
                    </td>
                    <td>
                        @if (item.Activo)
                        {
                            @Html.Raw("<small class='label pull-center bg-green'>Activo</small>")
                        }
                        else
                        {
                            @Html.Raw("<small class='label pull-center bg-red'>Desactivado</small>")
                        }
                    </td>              
             
                 <td>
                    <a onclick="asignarPlantilla(@item.Id)" title="Asignar Plantilla" class="btn btn-primary btn-xs"><i class="fa fa-sticky-note"></i></a>
                    @* <a onclick="cambiarOrdenPromocion(@item.Id)" title="Asignar Lista de Distribución" class="btn btn-info btn-xs"><i class="fa fa-users"></i></a> *@
                    @if (item.Activo)
                    {
                        <a onclick="borrarBanner(@item.Id)" title="Deshabilitar" class="btn btn-danger btn-xs"><i class="fa fa-close"></i></a>
                    }
                    else
                    {
                        <a onclick="borrarBanner(@item.Id)" title="Habilitar" class="btn btn-success btn-xs"><i class="fa fa-check"></i></a>
                    }
                </td>
             </tr>
            }
        </tbody>
    </table>
</box-body>


<modal title="Nueva Notificación" function="nuevaNotificacion" load-url="/Core/Notificaciones/_Create/" size="Medium"></modal>