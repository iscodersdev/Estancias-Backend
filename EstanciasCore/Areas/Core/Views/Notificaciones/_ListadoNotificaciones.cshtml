@using DAL.Models.Core
@model Commons.Models.Page<Notificaciones>

<box-header title="@ViewBag.Titulo">
    <box-search update-div="tablaBanners">
        <div class="input-group input-group-sm pull-right" style="max-width: 300px;">
            <a onclick="nuevaNotificacion()" class="btn btn-info btn-sm">
                <i class="fa fa-plus"><span class="hidden-xs"> Nueva</span></i>
            </a>
        </div>
    </box-search>
</box-header>

<box-body table="true">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Nombre
                </th>
                <th>
                    Descripcion
                </th>
                <th>
                    Fecha
                </th>
                <th>
                    Plantilla
                </th>
                <th>
                    Lista
                </th>
                <th>
                    Estado
                </th>
                <th>
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descripcion)
                    </td>
                    <td>
                        @Convert.ToDateTime(item.FechaEjecucion).ToString("dd/MM/yyyy HH:mm")
                    </td>
                    <td>
                        @if (item.NotificacionesPlantillas!=null)
                        {
                            @Html.Raw($"<small class='label pull-center bg-primary'>{item.NotificacionesPlantillas.Nombre}</small>")
                        }
                        else
                        {
                            @Html.Raw("<small class='label pull-center bg-yellow'>Sin Plantilla</small>")
                        }
                    </td>
                    <td>
                        @if (item.ListaDistribucion!=null)
                        {
                            @Html.Raw($"<small class='label pull-center bg-purple'>{item.ListaDistribucion.Nombre}</small>")
                        }
                        else
                        {
                            @Html.Raw("<small class='label pull-center bg-orange'>Sin Plantilla</small>")
                        }
                    </td>
                    <td>
                        @if (item.Activo)
                        {
                            @Html.Raw("<small class='label pull-center bg-green'>Activo</small>")
                        }
                        else
                        {
                            @Html.Raw("<small class='label pull-center bg-red'>Desactivado</small>")
                        }
                    </td>              
             
                 <td>
                    <a onclick="editarNotificacion(@item.Id)" title="Editar Notificación" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                    <a onclick="asignarPlantilla(@item.Id)" title="Asignar Plantilla" class="btn btn-warning btn-xs"><i class="fa fa-sticky-note"></i></a>
                    <a onclick="asignarListaDistribucion(@item.Id)" title="Asignar Lista de Distribución" class="btn btn-info btn-xs"><i class="fa fa-users"></i></a>
                    @if (item.Activo)
                    {
                        <a onclick="borrarNotificacion(@item.Id)" title="Deshabilitar" class="btn btn-danger btn-xs"><i class="fa fa-close"></i></a>
                    }
                    else
                    {
                        <a onclick="borrarNotificacion(@item.Id)" title="Habilitar" class="btn btn-success btn-xs"><i class="fa fa-check"></i></a>
                    }
                    <a onclick="borrarNotificacionPermanente(@item.Id)" title="Borrar" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></a>
                </td>
             </tr>
            }
        </tbody>
    </table>
</box-body>


<modal title="Nueva Notificación" function="nuevaNotificacion" load-url="/Core/Notificaciones/_Create/" size="Medium"></modal>
<modal title="Editar Notificación" function="editarNotificacion" load-url="/Core/Notificaciones/_Update/" size="Medium"></modal>