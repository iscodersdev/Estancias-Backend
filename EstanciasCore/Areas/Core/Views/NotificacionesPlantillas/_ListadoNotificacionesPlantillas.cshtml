@using DAL.Models.Core
@model Commons.Models.Page<NotificacionesPlantillas>

<style>
    /* Centrar contenido horizontal y verticalmente */
    .table td, .table th {
        vertical-align: middle !important; /* Alineación vertical */
        text-align: center; /* Alineación horizontal */
    }

    /* Si tienes imágenes como en tu captura, esto asegura que no rompan el layout */
    .table img {
        display: block;
        margin: 0 auto;
    }

    /* Cambia el color de fondo de la fila al pasar el mouse */
    .table tbody tr:hover {
        background-color: #f5f5f5 !important; /* Un gris muy claro */
        transition: background-color 0.2s ease; /* Hace que el cambio sea suave */
        cursor: pointer; /* Cambia el cursor a una mano */
    }   
</style>

<box-header title="@ViewBag.Titulo">
    <box-search update-div="tablaBanners">
        <div class="input-group input-group-sm pull-right" style="max-width: 300px;">
            @if (ViewBag.BotonNuevo)
            {
                <a href="/Core/NotificacionesPlantillas/Create" class="btn btn-info btn-sm">
                    <i class="fa fa-plus"><span class="hidden-xs"> Nueva</span></i>
                </a>
            }
        </div>
    </box-search>
</box-header>

<box-body table="true">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    Nombre
                </th>
                <th>
                    Titulo
                </th>
                <th>
                    Mensaje
                </th>
                <th>
                    Icono
                </th>
                <th>
                    Imagen
                </th>
                <th>
                    Link
                </th>
                <th>
                    Acciones
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nombre)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Titulo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Mensaje)
                    </td>
                    <td>
                        @if (item.Icon != null)
                        {
                            <img src="@item.Icon" alt="Miniatura" style="width: 60px; height: 60px; object-fit: cover;" />
                        }
                        else
                        {
                            @Html.Raw("Sin Icono")
                        }
                    </td>
                    <td>
                        @if (item.ImagenUrl != null)
                        {
                            <img src="@item.ImagenUrl" alt="Miniatura" style="width: 60px; height: 60px; object-fit: cover;" />
                        }
                        else
                        {
                            @Html.Raw("Sin Imagen")
                        }
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DeepLink)
                    </td>
                    <td>
                        <a href="/Core/NotificacionesPlantillas/Update/@item.Id" title="Edita" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                        <a onclick="enviarTest(@item.Id)" title="Enviar Test" class="btn btn-success btn-xs"><i class="fa fa-paper-plane"></i></a>
                        @if (ViewBag.BotonBorrar)
                        {
                            <a onclick="borrarPlantilla(@item.Id)" title="Borrar Plantilla" class="btn btn-danger btn-xs"><i class="fa fa-trash"></i></a>                            
                        }
                 </td>
             </tr>
            }
        </tbody>
    </table>
</box-body>


<modal title="Nueva Notificación" function="nuevaNotificacion" load-url="/Core/Notificaciones/_Create/" size="Medium"></modal>