@model Commons.Models.Page<DAL.Models.DatosEstructura>

<div class="box box-info">
    <div class="box-header with-border filtro-grilla">
        <span class="txt-titulo-box">Datos de Empresa</span>
    </div>
    <div class="box-body">
        <table id="listadoDatosEmpresa" class="table table-hover table-bordered table-responsive borde_interno">
            <thead>
                <tr>
                    <th>Alias</th>
                    <th>CBU</th>
                    <th>WhatsApp</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.Alias)</td>
                        <td>@Html.DisplayFor(m => item.CBU)</td>
                        <td>@Html.DisplayFor(m => item.Telefono)</td>
                        <td class="text-center">
                            <a onclick="editDatosEmpresa('@item.Id')" title="Editar" class="btn btn-primary btn-xs">
                                <i class="fa fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<modal title="Edición de Datos" callback-modal="true" function="editDatosEmpresa" load-url="/Core/DatosEmpresa/_Update/" size="Medium"></modal>

<script>
    $(document).ready(function () {
        $('#listadoDatosEmpresa').DataTable({
            "columnDefs": [{  "targets": 0 }, {  class: "text-center", "searchable": false, "orderable": false, "targets": 1 }],
            "language": {
                'url': '@Url.Content("~/lib/arg.json")'
            }
        });
    });
</script>
