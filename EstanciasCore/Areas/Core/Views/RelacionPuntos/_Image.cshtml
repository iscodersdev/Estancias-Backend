@using Commons.HtmlHelpers
@model DAL.Models.RelacionPuntos
@{
    ViewData["Title"] = "Cargar Imagen de la Relación Puntos";
}

<form asp-action="_Image" asp-controller="RelacionPuntos" asp-area="Core" enctype="multipart/form-data">

    @using (Html.BoxBody())
    {
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label">Seleccione una Imagen:</label>
                    <input class="preview" type="file" name="FotoRelacion" data-div="FotoRelacionUpdate" required />
                    <span class="help-block" style="font-size: 12px; margin-top: 5px;">* La imagen no puede ser mayor a 1080x1080</span>
                    <span id="alertaFondoRelacion" class="text-danger"></span>
                </div>
                <div class="col-md-6" style="text-align: center;">
                    <div id="FotoRelacionUpdate">
                        @if (@ViewBag.Foto != null)
                        {
                            <img src="data:image/jpeg;base64,@ViewBag.Foto" style="max-height:80px; max-width:160px;" />
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @using (Html.BoxFooter())
    {
        <a class="btn btn-danger" data-dismiss="modal">Cancelar</a>
        <input type="submit" value="Guardar" class="btn btn-info pull-right" />
    }

</form>

<script>
    $(function () {
        $(".preview").on("change", function (e) {
            if (e.target.files && e.target.files[0]) {
                let reader = new FileReader();
                reader.readAsDataURL(e.target.files[0]);
                reader.onload = function () {
                    let targetId = $(e.target).data("div");
                    let preview = document.getElementById(targetId);
                    let image = document.createElement('img');
                    image.style.maxHeight = "80px";
                    image.style.maxWidth = "160px";
                    image.src = reader.result;
                    preview.innerHTML = '';
                    preview.append(image);
                };
            }
        });
    });
</script>
