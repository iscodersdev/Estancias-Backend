@model Commons.Models.Page<DAL.Models.RelacionPuntos>

<div class="box box-info">
    <div class="box-header with-border filtro-grilla">
        <span class="txt-titulo-box">Listado de Relación Puntos</span>
        <div class="input-group input-group-sm pull-right" style="max-width: 300px;">
            <a onclick="nuevaRelacion()" class="btn btn-info btn-sm">
                <i class="fa fa-plus"><span class="hidden-xs"> Nueva</span></i>
            </a>
        </div>
    </div>
    <div class="box-body">
        <table id="listadoRelacion" class="table table-hover table-bordered table-responsive borde_interno">
            <thead>
                <tr>
                    <th>
                        Monto
                    </th>
                    <th>
                        Puntos
                    </th>
                    <th>
                        Acciones
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Monto)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Puntos)
                        </td>
                        <td>
                            @if (item.Imagen != null)
                            {
                                <a onclick="imagenRelacion('@item.Id')" title="Editar Imagen" class="btn btn-warning btn-xs"><i class="fa fa-image"></i></a>
                            }
                            else
                            {
                                <a onclick="imagenRelacion('@item.Id')" title="No ha ingresado Imagen" class="btn btn-danger btn-xs">
                                    <i class="fa fa-image"></i>
                                    <i class="fa fa-exclamation"></i>
                                </a>
                            }
                            <a onclick="editRelacion('@item.Id')" title="Editar Relación" class="btn btn-primary btn-xs"><i class="fa fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" confirm-icon="Danger" confirm-no="Cancelar" confirm-yes="Borrar" confirm="¿Esta seguro de borrar esta Relación?" class="btn btn-danger btn-xs"><i class="fa fa-trash-o"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<modal title="Nueva Relación" callback-modal="true" function="nuevaRelacion" load-url="/Core/RelacionPuntos/_Create/" size="Medium"></modal>
<modal title="Edición de Relación" callback-modal="true" function="editRelacion" load-url="/Core/RelacionPuntos/_Update/" size="Medium"></modal>
<modal title="Cambiar Imagen" callback-modal="true" function="imagenRelacion" load-url="/Core/RelacionPuntos/_Image/" size="Medium"></modal>

<script>
    $(document).ready(function () {
        $('#listadoRelacion').DataTable({
            "columnDefs": [{ "width": "45%", "targets": 0 }, { "width": "45%", "targets": 0 }, { "width": "10%", class: "text-center", "searchable": false, "orderable": false, "targets": 1 }],
            "language": {
                'url': '@Url.Content("~/lib/arg.json")'
            }
        });
    });
</script>
