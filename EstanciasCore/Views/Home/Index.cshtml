@model DAL.Models.Usuario

@{
    ViewData["Title"] = "Tablero Principal Interactivo";
}

<!-- Styling & Animations -->
<style>
    .dash-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        margin-bottom: 20px;
        overflow: hidden;
        position: relative;
    }
    .dash-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
    }
    .dash-card .card-body {
        padding: 20px;
        color: #fff;
    }
    .dash-card .card-icon {
        position: absolute;
        right: 15px;
        top: 15px;
        font-size: 55px;
        opacity: 0.25;
        transition: all 0.3s ease;
    }
    .dash-card:hover .card-icon {
        opacity: 0.4;
        transform: scale(1.1);
    }
    .dash-card .card-number {
        font-size: 32px;
        font-weight: 700;
        margin: 0;
        line-height: 1.2;
    }
    .dash-card .card-label {
        font-size: 14px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        opacity: 0.9;
    }
    .dash-card .card-footer-btn {
        display: block;
        background: rgba(0, 0, 0, 0.15);
        color: rgba(255, 255, 255, 0.9);
        padding: 8px 15px;
        text-align: right;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease;
    }
    .dash-card .card-footer-btn:hover {
        background: rgba(0, 0, 0, 0.25);
        color: #fff;
    }
    
    /* Gradients */
    .bg-grad-green { background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); }
    .bg-grad-orange { background: linear-gradient(135deg, #FF8008 0%, #FFC837 100%); }
    .bg-grad-cyan { background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%); }
    .bg-grad-purple { background: linear-gradient(135deg, #8E2DE2 0%, #4A00E0 100%); }

    /* Widgets */
    .panel-widget {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
        border: 1px solid #eef2f5;
    }
    .panel-widget .panel-header {
        padding: 15px 20px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .panel-widget .panel-title {
        font-size: 16px;
        font-weight: 700;
        color: #334155;
        margin: 0;
    }
    .panel-widget .panel-body {
        padding: 20px;
    }

    .spinner-loader {
        display: inline-block;
        font-size: 16px;
        color: rgba(255, 255, 255, 0.8);
    }

    /* Quick Access Flex Buttons */
    .quick-access-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-radius: 10px;
        color: #fff !important;
        text-decoration: none !important;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
    }
    .quick-access-btn:hover {
        transform: translateX(4px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        opacity: 0.95;
    }
    .quick-access-btn .btn-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .quick-access-btn i {
        font-size: 18px;
        width: 22px;
        text-align: center;
    }

</style>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Tarjetas Métricas (Cargadas Asincrónicamente y filtradas por roles) -->
<div class="row">
    
    <!-- Pagos del Día -->
    <div class="col-lg-3 col-md-6 col-xs-12 card-wrapper" id="boxPagos" style="display: none;">
        <div class="dash-card bg-grad-green">
            <div class="card-body">
                <div class="card-label">Pagos del Día</div>
                <div class="card-number" id="numPagosHoy"><i class="fa fa-spinner fa-spin spinner-loader"></i></div>
                <div style="font-size: 13px; font-weight: 600; margin-top: 4px;" id="montoPagosHoy">
                    Total: $0.00
                </div>
                <i class="fa fa-credit-card card-icon"></i>
            </div>
            <a href="/Core/PagoTarjeta" class="card-footer-btn">Ver Detalle <i class="fa fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Solicitudes Pendientes -->
    <div class="col-lg-3 col-md-6 col-xs-12 card-wrapper" id="boxSolicitudes" style="display: none;">
        <div class="dash-card bg-grad-orange">
            <div class="card-body">
                <div class="card-label">Solicitudes Pendientes</div>
                <div class="card-number" id="numSolicitudesPendientes"><i class="fa fa-spinner fa-spin spinner-loader"></i></div>
                <div style="font-size: 13px; margin-top: 4px;">Revisión requerida</div>
                <i class="fa fa-id-card-o card-icon"></i>
            </div>
            <a href="/Core/SolicitudDeTarjeta" class="card-footer-btn">Gestionar <i class="fa fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Socios Con App -->
    <div class="col-lg-3 col-md-6 col-xs-12 card-wrapper" id="boxSociosApp" style="display: none;">
        <div class="dash-card bg-grad-cyan">
            <div class="card-body">
                <div class="card-label">Socios con App</div>
                <div class="card-number" id="numSociosApp"><i class="fa fa-spinner fa-spin spinner-loader"></i></div>
                <div style="font-size: 13px; margin-top: 4px;">Usuarios registrados</div>
                <i class="fa fa-users card-icon"></i>
            </div>
            <a href="/Core/Clientes" class="card-footer-btn">Ver Lista <i class="fa fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Socios Nuevos del Mes -->
    <div class="col-lg-3 col-md-6 col-xs-12 card-wrapper" id="boxSociosNuevos" style="display: none;">
        <div class="dash-card bg-grad-purple">
            <div class="card-body">
                <div class="card-label">Nuevos del Mes</div>
                <div class="card-number" id="numSociosNuevos"><i class="fa fa-spinner fa-spin spinner-loader"></i></div>
                <div style="font-size: 13px; margin-top: 4px;">Últimos 30 días</div>
                <i class="fa fa-user-plus card-icon"></i>
            </div>
            <a href="/Core/Clientes" class="card-footer-btn">Ver Clientes <i class="fa fa-arrow-circle-right"></i></a>
        </div>
    </div>

</div>

<!-- Gráficos Interactivos -->
<div class="row" id="rowGraficos" style="display: none;">
    <div class="col-md-6 col-xs-12" id="panelGraficoSolicitudes" style="display: none;">
        <div class="panel-widget">
            <div class="panel-header">
                <h4 class="panel-title"><i class="fa fa-pie-chart text-primary"></i> Solicitudes por Estado</h4>
                <span class="label label-info">En tiempo real</span>
            </div>
            <div class="panel-body">
                <div style="height: 250px; position: relative;">
                    <canvas id="chartSolicitudes"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xs-12" id="panelGraficoOperaciones">
        <div class="panel-widget">
            <div class="panel-header">
                <h4 class="panel-title"><i class="fa fa-bar-chart text-success"></i> Resumen de Operaciones</h4>
                <span class="label label-success">General</span>
            </div>
            <div class="panel-body">
                <div style="height: 250px; position: relative;">
                    <canvas id="chartOperaciones"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tablas de Previsualización y Accesos Rápidos -->
<div class="row">
    <div class="col-md-8 col-xs-12">
        <div class="nav-tabs-custom" style="border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
            <ul class="nav nav-tabs">
                <li class="active" id="tabHeadSolicitudes" style="display: none;"><a href="#tab_solicitudes" data-toggle="tab"><i class="fa fa-id-card"></i> Últimas Solicitudes</a></li>
                <li id="tabHeadPagos" style="display: none;"><a href="#tab_pagos" data-toggle="tab"><i class="fa fa-credit-card"></i> Últimos Pagos del Día</a></li>
            </ul>
            <div class="tab-content" style="padding: 15px;">
                <div class="tab-pane" id="tab_solicitudes">
                    <div id="contenedorUltimasSolicitudes"><i class="fa fa-spinner fa-spin"></i> Cargando...</div>
                </div>
                <div class="tab-pane" id="tab_pagos">
                    <div id="contenedorUltimosPagos"><i class="fa fa-spinner fa-spin"></i> Cargando...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos Rápidos por Rol -->
    <div class="col-md-4 col-xs-12">
        <div class="panel-widget">
            <div class="panel-header">
                <h4 class="panel-title"><i class="fa fa-rocket text-warning"></i> Accesos Rápidos</h4>
            </div>
            <div class="panel-body" style="display: flex; flex-direction: column; gap: 10px;" id="panelAccesosRapidos">
                <div class="text-center text-muted"><i class="fa fa-spinner fa-spin"></i> Cargando accesos...</div>
            </div>
        </div>
    </div>
</div>

<!-- Carga Asincrónica AJAX y Configuración por Roles -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        cargarDashboardAsync();
    });

    function cargarDashboardAsync() {
        $.ajax({
            url: '/Home/ObtenerMetricasDashboard',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                renderizarDashboard(data);
            },
            error: function (err) {
                console.error("Error al cargar datos del dashboard:", err);
            }
        });
    }

    function renderizarDashboard(d) {
        var hayGraficos = false;

        // 1. Permiso Clientes
        if (d.puedeVerClientes) {
            $('#boxSociosApp').show();
            $('#boxSociosNuevos').show();
            animateCounter('#numSociosApp', d.sociosConApp);
            animateCounter('#numSociosNuevos', d.sociosNuevosMes);
        }

        // 2. Permiso Pagos
        if (d.puedeVerPagos) {
            $('#boxPagos').show();
            animateCounter('#numPagosHoy', d.pagosHoyCantidad);
            $('#montoPagosHoy').html('Total: $' + parseFloat(d.pagosHoyMonto).toLocaleString('es-AR', { minimumFractionDigits: 2 }));
            
            $('#tabHeadPagos').show();
            renderTablaPagos(d.ultimosPagos);
        }

        // 3. Permiso Solicitudes
        if (d.puedeVerSolicitudes) {
            $('#boxSolicitudes').show();
            animateCounter('#numSolicitudesPendientes', d.solicitudesPendientes);

            $('#panelGraficoSolicitudes').show();
            hayGraficos = true;
            renderGraficoSolicitudes(d.solicitudesPendientes, d.solicitudesAprobadas, d.solicitudesRechazadas);

            $('#tabHeadSolicitudes').show();
            if (!$('#tabHeadPagos').hasClass('active')) {
                $('#tabHeadSolicitudes').addClass('active');
                $('#tab_solicitudes').addClass('active');
            }
            renderTablaSolicitudes(d.ultimasSolicitudes);
        } else if (d.puedeVerPagos) {
            $('#tabHeadPagos').addClass('active');
            $('#tab_pagos').addClass('active');
        }

        if (d.puedeVerPagos || d.puedeVerSolicitudes || d.puedeVerClientes || d.puedeVerMorosos) {
            $('#rowGraficos').show();
            renderGraficoOperaciones(d);
        }

        // 4. Accesos Rápidos filtrados por Rol
        renderAccesosRapidos(d);
    }

    function animateCounter(selector, targetVal) {
        $({ countNum: 0 }).animate({ countNum: targetVal }, {
            duration: 800,
            easing: 'swing',
            step: function () {
                $(selector).text(Math.floor(this.countNum));
            },
            complete: function () {
                $(selector).text(this.countNum);
            }
        });
    }

    function renderTablaSolicitudes(lista) {
        if (!lista || lista.length === 0) {
            $('#contenedorUltimasSolicitudes').html('<p class="text-muted text-center" style="padding: 20px;">No hay solicitudes registradas recientemente.</p>');
            return;
        }
        var html = '<table class="table table-hover table-striped"><thead><tr><th>Solicitante</th><th>DNI</th><th>Fecha</th><th class="text-center">Estado</th></tr></thead><tbody>';
        $.each(lista, function (i, item) {
            var nombre = item.nombreCompleto || item.NombreCompleto || '-';
            var dni = item.dni || item.DNI || item.Dni || '-';
            var fecha = item.fecha || item.Fecha || '-';
            var estadoId = item.estadoId || item.EstadoId || 1;

            var badge = '<span class="label label-primary">Pendiente</span>';
            if (estadoId === 2) badge = '<span class="label label-success">Aprobada</span>';
            else if (estadoId === 3) badge = '<span class="label label-danger">Rechazada</span>';

            html += '<tr><td><strong>' + nombre + '</strong></td><td>' + dni + '</td><td>' + fecha + '</td><td class="text-center">' + badge + '</td></tr>';
        });
        html += '</tbody></table><div class="text-right"><a href="/Core/SolicitudDeTarjeta" class="btn btn-sm btn-default">Ir a Solicitudes &rarr;</a></div>';
        $('#contenedorUltimasSolicitudes').html(html);
    }

    function renderTablaPagos(lista) {
        if (!lista || lista.length === 0) {
            $('#contenedorUltimosPagos').html('<p class="text-muted text-center" style="padding: 20px;">No se registraron pagos hoy.</p>');
            return;
        }
        var html = '<table class="table table-hover table-striped"><thead><tr><th>Titular</th><th>N° Tarjeta</th><th>Monto</th><th>Fecha</th></tr></thead><tbody>';
        $.each(lista, function (i, item) {
            var persona = item.personaNombre || item.PersonaNombre || '-';
            var tarjeta = item.nroTarjeta || item.NroTarjeta || '-';
            var monto = item.montoInformado || item.MontoInformado || 0;
            var fecha = item.fecha || item.Fecha || '-';

            html += '<tr><td><strong>' + persona + '</strong></td><td>' + tarjeta + '</td><td><strong class="text-success">$' + parseFloat(monto).toLocaleString('es-AR', { minimumFractionDigits: 2 }) + '</strong></td><td>' + fecha + '</td></tr>';
        });
        html += '</tbody></table><div class="text-right"><a href="/Core/PagoTarjeta" class="btn btn-sm btn-default">Ir a Pagos &rarr;</a></div>';
        $('#contenedorUltimosPagos').html(html);
    }


    function renderAccesosRapidos(d) {
        var html = '';
        if (d.puedeVerSolicitudes) {
            html += '<a href="/Core/SolicitudDeTarjeta" class="quick-access-btn" style="background: linear-gradient(135deg, #3c8dbc, #286090);"><div class="btn-left"><i class="fa fa-id-card"></i> <span>Solicitudes de Tarjeta</span></div><span class="badge" style="background: #ff851b; font-size: 12px; padding: 5px 10px;">' + d.solicitudesPendientes + '</span></a>';
        }
        if (d.puedeVerPagos) {
            html += '<a href="/Core/PagoTarjeta" class="quick-access-btn" style="background: linear-gradient(135deg, #00a65a, #008d4c);"><div class="btn-left"><i class="fa fa-credit-card"></i> <span>Gestión de Pagos</span></div><span class="badge" style="background: #00e676; color: #004d40; font-size: 12px; padding: 5px 10px;">' + d.pagosHoyCantidad + '</span></a>';
        }
        if (d.puedeVerClientes) {
            html += '<a href="/Core/Clientes" class="quick-access-btn" style="background: linear-gradient(135deg, #00c6ff, #0072ff);"><div class="btn-left"><i class="fa fa-users"></i> <span>Clientes y Socios</span></div><span class="badge" style="background: #004085; font-size: 12px; padding: 5px 10px;">' + d.sociosConApp + '</span></a>';
        }
        if (d.puedeVerMorosos) {
            html += '<a href="/Core/Morosos" class="quick-access-btn" style="background: linear-gradient(135deg, #dd4b39, #c9302c);"><div class="btn-left"><i class="fa fa-exclamation-triangle"></i> <span>Listado de Morosos</span></div><span class="badge" style="background: #721c24; font-size: 12px; padding: 5px 10px;">' + d.morososCount + '</span></a>';
        }
        if (!html) {
            html = '<p class="text-muted text-center">No hay accesos configurados para su rol.</p>';
        }
        $('#panelAccesosRapidos').html(html);
    }


    function renderGraficoSolicitudes(pend, aprob, rech) {
        var ctx = document.getElementById('chartSolicitudes').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Pendientes', 'Aprobadas', 'Rechazadas'],
                datasets: [{
                    data: [pend, aprob, rech],
                    backgroundColor: ['#3c8dbc', '#00a65a', '#dd4b39'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: { position: 'bottom' }
            }
        });
    }

    function renderGraficoOperaciones(d) {
        var labels = [];
        var dataVal = [];
        var colors = [];

        if (d.puedeVerPagos) { labels.push('Pagos Hoy'); dataVal.push(d.pagosHoyCantidad); colors.push('#38ef7d'); }
        if (d.puedeVerSolicitudes) { labels.push('Solicitudes Pend.'); dataVal.push(d.solicitudesPendientes); colors.push('#FFC837'); }
        if (d.puedeVerSolicitudes) { labels.push('Solicitudes Aprob.'); dataVal.push(d.solicitudesAprobadas); colors.push('#0072ff'); }
        if (d.puedeVerMorosos) { labels.push('Morosos'); dataVal.push(d.morososCount); colors.push('#ef473a'); }

        var ctx = document.getElementById('chartOperaciones').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Cantidad',
                    data: dataVal,
                    backgroundColor: colors,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: { display: false },
                scales: { yAxes: [{ ticks: { beginAtZero: true, precision: 0 } }] }
            }
        });
    }
</script>